# Bot token from https://discord.com/developers/applications
DISCORD_TOKEN=

# Optional: register commands in a single guild for instant availability while developing.
# Leave empty to register globally (may take up to an hour to propagate).
GUILD_ID=

# Feature toggles. Accepted values are true or false.
# Enable the admin-only /dashboard command.
DASHBOARD_ENABLED=false

# Send quest completion updates by DM instead of the channel progress embed.
DM_QUEST_UPDATES=true

# Quest activity logging. Accepted values are true or false.
# Master switch. When false, nothing is logged anywhere, whatever the settings below say.
LOGGING_MODE=true

# Print quest activity to the console.
LOG_CONSOLE_ENABLED=true

# Send quest activity to a Discord webhook. Needs LOG_WEBHOOK_URL.
# The URL is a secret, keep it out of git and never share it.
LOG_WEBHOOK_ENABLED=false
LOG_WEBHOOK_URL=

# Send quest activity to a channel the bot can post in. Needs LOG_CHANNEL_ID.
LOG_CHANNEL_ENABLED=false
LOG_CHANNEL_ID=
